[Unit]
Description=LFClaw Enterprise Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lfclaw
Group=lfclaw
WorkingDirectory=/opt/LfClaw/enterprise-server
EnvironmentFile=/etc/lfclaw-enterprise.env
ExecStart=/usr/bin/node /opt/LfClaw/enterprise-server/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
