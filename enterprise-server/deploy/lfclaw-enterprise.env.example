LFCLAW_ENTERPRISE_HOST=0.0.0.0
LFCLAW_ENTERPRISE_PORT=8787
# Optional but recommended behind a reverse proxy. Example: http://8.216.38.213:8787
LFCLAW_PUBLIC_BASE_URL=
LFCLAW_ADMIN_TOKEN=replace-with-a-strong-secret
LFCLAW_ENTERPRISE_DATA_DIR=/opt/LfClaw/data
LFCLAW_ENTERPRISE_STORAGE=/opt/LfClaw/storage
LFCLAW_ENTERPRISE_RELEASE_DIR=/opt/LfClaw/releases
LFCLAW_ENTERPRISE_LAST_SEEN_FLUSH_MS=300000
LFCLAW_ENTERPRISE_SESSION_TTL_DAYS=30
LFCLAW_ENTERPRISE_USAGE_RETENTION_DAYS=180
LFCLAW_ENTERPRISE_USAGE_MAX_EVENTS=100000

# OpenViking runs on the same host and must not be exposed to the public network.
LFCLAW_OPENVIKING_UPSTREAM_URL=http://127.0.0.1:1933
LFCLAW_OPENVIKING_ACCOUNT_ID=lfclaw
LFCLAW_OPENVIKING_TIMEOUT_MS=2500
LFCLAW_OPENVIKING_TASK_POLL_WINDOW_MS=10000
LFCLAW_OPENVIKING_MAX_BODY_BYTES=2097152
LFCLAW_OPENVIKING_MAX_CONCURRENT=32

# Leave empty for trusted loopback auth. With API-key auth, put the OpenViking
# root key only in the real server environment file.
LFCLAW_OPENVIKING_API_KEY=
