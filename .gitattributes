# Force LF line endings for shell scripts (required for bash on all platforms)
*.sh text eol=lf
releases/**/*.exe filter=lfs diff=lfs merge=lfs -text
releases/**/*.dmg filter=lfs diff=lfs merge=lfs -text
releases/**/*.pkg filter=lfs diff=lfs merge=lfs -text
releases/**/*.zip filter=lfs diff=lfs merge=lfs -text
releases/**/*.blockmap filter=lfs diff=lfs merge=lfs -text
